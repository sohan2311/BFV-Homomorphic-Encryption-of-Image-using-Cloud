generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

enum TaskStatus {
  PENDING_ADMIN
  PROCESSED_READY
  DOWNLOADED
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          Role     @default(USER)
  createdAt     DateTime @default(now()) @map("created_at")
  sentTasks     Task[]   @relation("TaskSender")
  receivedTasks Task[]   @relation("TaskReceiver")

  @@map("users")
}

model Task {
  id               String     @id @default(uuid())
  senderId         String     @map("sender_id")
  receiverId       String     @map("receiver_id")
  originalImageUrl String     @map("original_image_url")
  memFileUrl       String?    @map("mem_file_url")
  cipherKey        String?    @map("cipher_key")
  status           TaskStatus @default(PENDING_ADMIN)
  createdAt        DateTime   @default(now()) @map("created_at")
  sender           User       @relation("TaskSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver         User       @relation("TaskReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("tasks")
}
